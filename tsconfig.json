{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./frontend/*"],
      "@/assets/*": ["./frontend/assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "frontend/app/admin/(tab)/menu.jsx"
, "frontend/app/admin/(tab)/_layout.jsx"  ]
}
