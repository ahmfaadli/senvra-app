{
  "expo": {
    "name": "senvra-app",
    "slug": "senvra-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./frontend/assets/images/icon-senvra.png",
    "scheme": "senvraapp",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./frontend/assets/expo.icon"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./frontend/assets/images/android-icon-foreground.png",
        "backgroundImage": "./frontend/assets/images/android-icon-background.png",
        "monochromeImage": "./frontend/assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.senvraid.senvraapp"
    },

    "web": {
      "output": "static",
      "favicon": "./frontend/assets/images/favicon.png"
    },

    "plugins": [
      [
        "expo-router",
        {
          "root": "./frontend/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./frontend/assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "77ef7d69-e5a8-4ce4-b125-49d0e51f4891"
      }
    }
  }
}