{
  "expo": {
    "name": "senvra-app",
    "slug": "senvra-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./frontend/assets/images/icon-senvra.png",
    "scheme": "senvraapp",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./frontend/assets/images/icon-senvra.png"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#123F68",
        "foregroundImage": "./frontend/assets/images/icon-senvra-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.senvraid.senvraapp"
    },

    "web": {
      "output": "static",
      "favicon": "./frontend/assets/images/favsenvra.png"
    },

    "plugins": [
      [
        "expo-router",
        {
          "root": "./frontend/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#123F68",
          "image": "./frontend/assets/images/splash-senvra.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "77ef7d69-e5a8-4ce4-b125-49d0e51f4891"
      }
    },

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "url": "https://u.expo.dev/77ef7d69-e5a8-4ce4-b125-49d0e51f4891"
    }
  }
}